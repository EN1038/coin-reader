# ค่าตัวอย่างเท่านั้น · 6 พ.ย. 2569 เวลาไทย · ห้าม commit .env จริง
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_with_local_anon_key
# Server/Edge only — ห้ามใส่ VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
APP_ENV=local
MOCK_PAYMENTS_ENABLED=false
ALLOW_UNWATERMARKED_MOCK=false
ALLOWED_ORIGINS=http://localhost:5173
# สงวนไว้สำหรับ watermark renderer (ยังไม่ได้ implement)
WATERMARK_HMAC_KEY=replace_locally_only

# Optional local Edge pitch wrappers; ภายนอกใช้ client mock store ของส้ม
DEMO_BACKEND_ENABLED=false
